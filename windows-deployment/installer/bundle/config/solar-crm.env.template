# SolarCRM Runtime Configuration
# This file is auto-generated by the installer.
# Edit with care — restart the SolarCRM service after changes.
# Location: C:\SolarCRM\config\solar-crm.env

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_VERSION=1.0.0

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://solar_crm_user:solar_crm_db_pass@localhost:5432/solar_crm

# PostgreSQL superuser password (used by setup/backup scripts)
PG_PASSWORD=SolarCRM_PgSuperPass_2024!
DB_NAME=solar_crm
DB_USER=solar_crm_user
DB_PASS=solar_crm_db_pass

# ── Security ──────────────────────────────────────────────────────────────────
# Generated automatically during install. DO NOT SHARE THIS VALUE.
JWT_SECRET=REPLACE_WITH_GENERATED_SECRET

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set to * for LAN-wide access, or a specific domain for production HTTPS
ALLOWED_ORIGIN=*

# ── Server info (set by installer) ───────────────────────────────────────────
SERVER_IP=192.168.1.100
